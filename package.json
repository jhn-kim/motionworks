{
  "name": "motionworks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/motionworks"
  ],
  "scripts": {
    "build": "npm run build -w packages/motionworks",
    "test": "npm run test --if-present --workspaces",
    "typecheck": "tsc --build --force",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache --ignore-path .gitignore",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.8.2"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.28.2",
    "@rollup/rollup-linux-x64-gnu": "4.62.4"
  },
  "packageManager": "npm@11.12.1"
}
